---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FamilyProfile from '../components/FamilyProfile.astro';
import CoachSection from '../components/CoachSection.astro';

const lastName = (familyName) => familyName.replace(/^The /, '').replace(/ Family$/, '');
const families = (await getCollection('families')).sort((a, b) =>
  lastName(a.data.familyName).localeCompare(lastName(b.data.familyName))
);
const coaches = await getCollection('coaches');
---

<Layout title="2029 NC Courage Academy Families">
  <header class="site-header">
    <div class="site-header__inner">
      <div class="site-header__brand">
        <img class="logo" src="/images/courage.png" alt="2029 NC Courage Academy" />
        <p class="eyebrow-wrap eyebrow">
          <span class="unofficial-badge">unofficial</span>
          2029 NC Courage Academy
        </p>
      </div>
      <div class="site-header__text">
        <h1>Meet the Families</h1>
        <p>
          A place for our players, parents, and coaches to get to know one another
          on and off the field &mdash; hobbies, pets, and everything in between.
        </p>
      </div>
    </div>
  </header>

  <p class="player-sheets-link">
    <a href="/player-sheets">
      <svg class="player-sheets-link__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 6 2 18 2 18 9"></polyline>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
        <rect x="6" y="14" width="12" height="8"></rect>
      </svg>
      Printable player sheets
    </a>
  </p>

  <main class="wrapper">
    <section id="families">
      {families.map((family) => <FamilyProfile family={family} />)}
    </section>

    <section id="coach">
      <div class="section-title">
        <h2>From the Coach</h2>
      </div>
      {coaches.map((coach) => <CoachSection coach={coach} />)}
    </section>
  </main>

  <footer class="site-footer">
    <p>2029 NC Courage Academy</p>
  </footer>
</Layout>
