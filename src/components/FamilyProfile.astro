---
import { render } from 'astro:content';
import { resolvePhoto } from '../lib/photo.js';

const { family } = Astro.props;
const { Content } = await render(family);
const { familyName, playerName, jerseyNumber, parents, siblings, photo, photoAlt } = family.data;
---

<article class="card family-card" id={family.id}>
  <img class="photo" src={resolvePhoto(photo)} alt={photoAlt ?? familyName} loading="lazy" />
  <div class="content">
    <span class="player-tag">Player: {playerName}{jerseyNumber ? ` · #${jerseyNumber}` : ''}</span>
    <h2>{familyName}</h2>
    {parents && <p class="meta-line"><strong>Parents:</strong> {parents}</p>}
    {siblings && <p class="meta-line"><strong>Siblings:</strong> {siblings}</p>}
    <div class="prose">
      <Content />
    </div>
  </div>
</article>
