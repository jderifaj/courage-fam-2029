---
import { render } from 'astro:content';
import { resolvePhoto } from '../lib/photo.js';

const { coach } = Astro.props;
const { Content } = await render(coach);
const { name, role, email, photo, photoAlt } = coach.data;
---

<div class="card coach-card">
  <img src={resolvePhoto(photo)} alt={photoAlt ?? name} loading="lazy" />
  <div>
    <p class="role">{role}</p>
    <h2>{name}</h2>
    {email && <p><a href={`mailto:${email}`}>{email}</a></p>}
    <div class="prose">
      <Content />
    </div>
  </div>
</div>
